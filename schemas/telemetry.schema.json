{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetry v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string"
    },
    "trial_id": {
      "type": "string"
    },
    "monotonic_ns": {
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "utc_anchor": {
      "type": "object",
      "required": [
        "utc",
        "monotonic_ns"
      ],
      "properties": {
        "utc": {
          "type": "string"
        },
        "monotonic_ns": {
          "type": "integer"
        }
      }
    },
    "interval_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "missed_samples": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "trial_id",
    "monotonic_ns",
    "session_id",
    "phase",
    "utc_anchor",
    "interval_s",
    "missed_samples"
  ],
  "additionalProperties": true
}
