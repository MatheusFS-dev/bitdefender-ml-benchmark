{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trial v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string"
    },
    "trial_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "skipped",
        "interrupted"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "available",
              "unsupported",
              "denied",
              "missing",
              "invalid"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "value",
          "unit",
          "source",
          "scope",
          "availability",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "trial_id",
    "status",
    "metrics"
  ],
  "additionalProperties": true
}
